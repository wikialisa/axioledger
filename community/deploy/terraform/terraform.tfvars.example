# ─── terraform.tfvars.example ─────────────────────────────────────────────────
# Copy to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars — it is listed in .gitignore.

aws_region            = "ap-southeast-1"

# From .env.example / Cloudflare Dashboard
cloudflare_api_token  = "YOUR_CLOUDFLARE_API_TOKEN"
cloudflare_account_id = "YOUR_CLOUDFLARE_ZONE_AND_ACCOUNT_ID"
cloudflare_zone_id    = "YOUR_CLOUDFLARE_ZONE_AND_ACCOUNT_ID"

lb_origin             = "lb.your-project.vn"
environment           = "prod"
