{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": [
      "ES2022"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "ui-kit": [
        "."
      ],
      "project-types": [
        "."
      ],
      "project-config": [
        "."
      ],
      "core-sdk": [
        "."
      ],
      "project-db": [
        "."
      ],
      "merchant-sdk": [
        "."
      ],
      "sdk-internal": [
        "."
      ],
      "sdk-swift": [
        "."
      ],
      "swift-adapter": [
        "."
      ],
      "swift-sdk-internal": [
        "."
      ],
      "project-contracts": [
        "."
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
