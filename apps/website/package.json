{
  "name": "axioledger-website",
  "version": "0.1.0",
  "private": true,
  "description": "AXIOLEDGER — Official introductory website. Static export for GitHub Pages.",
  "scripts": {
    "dev":       "next dev --port 3010",
    "build":     "next build",
    "start":     "next start",
    "typecheck": "tsc --noEmit",
    "lint":      "next lint || true",
    "clean":     "rm -rf .next out"
  },
  "dependencies": {
    "next":      "16.4.5",
    "react":     "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react":     "^18.3.5",
    "@types/react-dom": "^18.3.5",
    "@types/node":      "^22.5.0",
    "typescript":       "^5.5.4"
  }
}
