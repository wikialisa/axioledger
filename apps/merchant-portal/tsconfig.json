{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "ui-kit": [
        "../../packages/ui-kit/src/index.ts"
      ],
      "project-types": [
        "../../packages/types/src/index.ts"
      ],
      "project-config": [
        "../../packages/config/src/index.ts"
      ],
      "core-sdk": [
        "../../packages/core-sdk/src/index.ts"
      ],
      "project-db": [
        "../../packages/db/src/index.ts"
      ],
      "merchant-sdk": [
        "../../packages/merchant-sdk/src/index.ts"
      ],
      "sdk-internal": [
        "../../packages/sdk-internal/src/index.ts"
      ],
      "sdk-swift": [
        "../../packages/sdk-swift/src/index.ts"
      ],
      "swift-adapter": [
        "../../packages/swift-adapter/src/index.ts"
      ],
      "swift-sdk-internal": [
        "../../packages/swift/src/index.ts"
      ],
      "project-contracts": [
        "../../packages/contracts/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}