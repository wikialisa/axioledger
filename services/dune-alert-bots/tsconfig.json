{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "ui-kit": [
        "."
      ],
      "project-types": [
        "."
      ],
      "project-config": [
        "."
      ],
      "core-sdk": [
        "."
      ],
      "project-db": [
        "."
      ],
      "merchant-sdk": [
        "."
      ],
      "sdk-internal": [
        "."
      ],
      "sdk-swift": [
        "."
      ],
      "swift-adapter": [
        "."
      ],
      "swift-sdk-internal": [
        "."
      ],
      "project-contracts": [
        "."
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
